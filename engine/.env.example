# Copy to .env and fill in. .env is gitignored.

# CFBD (CollegeFootballData) API key — free, sign up at https://collegefootballdata.com/
CFBD_API_KEY=

# AWS profile to use for engine operations (set up in ~/.aws/config)
AWS_PROFILE=portfolio
AWS_REGION=us-east-1

# S3 buckets — populated from CDK stack outputs after `cdk deploy`
S3_RAW_BUCKET=
S3_CURATED_BUCKET=
