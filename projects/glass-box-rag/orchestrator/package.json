{
  "name": "glass-box-rag-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "parity": "tsx src/parity.ts",
    "typecheck": "tsc --noEmit",
    "bundle": "npm run build && mkdir -p dist/data && cp ../data/build/chunks.json ../data/build/vectors-titan.bin ../data/build/vectors-titan.meta.json ../data/build/citation_edges.json dist/data/"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1040.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1040.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
